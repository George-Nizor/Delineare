{
  "name": "delineare",
  "version": "0.2.0",
  "private": true,
  "description": "Learn to draw, one skill at a time: what to do, how it looks done well, the best lessons on it, and practice for whenever you want it.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "content": "node scripts/build-content.mjs",
    "dev": "node scripts/build-content.mjs && vite",
    "build": "node scripts/build-content.mjs && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "lint:copy": "node scripts/build-content.mjs --check && node scripts/lint-copy.mjs",
    "e2e": "node scripts/e2e.mjs",
    "links": "node scripts/check-links.mjs",
    "brand": "node scripts/sync-brand.mjs"
  },
  "dependencies": {
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.5",
    "marked": "^18.1.1",
    "playwright": "^1.63.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "yaml": "^2.9.1"
  }
}
