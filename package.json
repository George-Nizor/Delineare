{
  "name": "delineare",
  "version": "0.1.0",
  "private": true,
  "description": "Learn to draw anything: a sequenced curriculum, practice sessions with a reference viewer, a drawing log, and links to free lessons with credit.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "node scripts/copy-curriculum.mjs && vite",
    "build": "node scripts/copy-curriculum.mjs && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "curriculum": "python3 curriculum/build_v2.py && python3 curriculum/validate.py",
    "brand": "node scripts/sync-brand.mjs"
  },
  "dependencies": {
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "fflate": "^0.8.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@fontsource-variable/newsreader": "^5.3.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.1.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
